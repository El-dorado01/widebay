// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// Required Auth.js models (adapted for SQLite)
model User {
  id            String    @id @default(uuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  role          String    @default("user") // "user" or "admin"

  accounts      Account[]
  sessions      Session[]

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  orders        Order[]

  @@map("users")
}

model Account {
  id                 String   @id @default(uuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?  // Removed @db.Text
  access_token       String?  // Removed @db.Text
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?  // Removed @db.Text
  session_state      String?

  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// Your custom models (unchanged)
model Category {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  products    Product[]

  @@map("categories")
}

model Product {
  id             String   @id @default(uuid())
  name           String
  description    String
  price          Float
  discountPrice  Float?
  stock          Int      @default(0)
  imageUrl       String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  categoryId     String
  category       Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  trending       TrendingProduct?
  discounted     DiscountedProduct?

  @@map("products")
}

model TrendingProduct {
  id         String @id @default(uuid())
  productId  String @unique
  product    Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  position   Int?

  createdAt  DateTime @default(now())

  @@index([position])
  @@map("trending_products")
}

model DiscountedProduct {
  id         String @id @default(uuid())
  productId  String @unique
  product    Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  position   Int?

  createdAt  DateTime @default(now())

  @@index([position])
  @@map("discounted_products")
}

model AdminEmail {
  id        String   @id @default(uuid())
  email     String   @unique
  createdAt DateTime @default(now())

  @@map("admin_emails")
}

model Order {
  id            String   @id @default(uuid())
  stripeSessionId String @unique
  customerEmail String?
  customerName  String?
  totalAmount   Int      // in cents
  currency      String   @default("usd")
  status        String   @default("paid") // paid, pending, failed, etc.
  shippingOption String  // "store-pickup" or "home-delivery"
  shippingAddress Json?   // from Stripe
  createdAt     DateTime @default(now())

  userId        String?
  user          User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  items         OrderItem[]

  @@map("orders")
}

model OrderItem {
  id        String @id @default(uuid())
  orderId   String
  order     Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  productId String
  name      String
  price     Int    // in cents
  quantity  Int
  imageUrl  String?

  @@map("order_items")
}